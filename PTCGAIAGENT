ate(obs.current.players[opp])\n","    encoded = torch.cat([stadium,player,opponent])\n","    return encoded"]},{"cell_type":"markdown","id":"2f52086c","metadata":{"id":"2936af8e","papermill":{"duration":0.007813,"end_time":"2026-11-16T06:19:24.590965+00:00","exception":false,"start_time":"2026-11-16T06:19:24.583152+00:00","status":"completed"},"tags":[]},"source":["## Neural Network Value Function paired with Tree Search\n","\n"]},{"cell_type":"markdown","id":"7a22b074","metadata":{"papermill":{"duration":0.008017,"end_time":"2026-11-16T06:19:24.607222+00:00","exception":false,"start_time":"2026-11-16T06:19:24.599205+00:00","status":"completed"},"tags":[]},"source":["Value Network"]},{"cell_type":"code","execution_count":14,"id":"a6404051","metadata":{"execution":{"iopub.execute_input":"2026-11-16T06:19:24.624067Z","iopub.status.busy":"2026-11-16T06:19:24.623396Z","iopub.status.idle":"2026-11-16T06:19:24.628162Z","shell.execute_reply":"2026-11-16T06:19:24.627647Z"},"papermill":{"duration":0.014445,"end_time":"2026-11-16T06:19:24.629446+00:00","exception":false,"start_time":"2026-11-16T06:19:24.615001+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class StateValueNetwork(nn.Module):\n","    def __init__(self, input_dim):\n","        super(StateValueNetwork, self).__init__()\n","        # Dense layers to process the tabular state vector\n","        self.fc1 = nn.Linear(input_dim, 256)\n","        self.fc2 = nn.Linear(256, 256)\n","        self.fc3 = nn.Linear(256, 128)\n","        \n","        # Value head outputting a single scalar score\n","        self.value_head = nn.Linear(128, 1)\n","\n","    def forward(self, x):\n","        x = F.relu(self.fc1(x))\n","        x = F.relu(self.fc2(x))\n","        x = F.relu(self.fc3(x))\n","        # Tanh maps output cleanly between -1 (Loss) and +1 (Win)\n","        return torch.tanh(self.value_head(x))"]},{"cell_type":"markdown","id":"0fe86173","metadata":{"papermill":{"duration":0.007598,"end_time":"2026-11-16T06:19:24.645025+00:00","exception":false,"start_time":"2026-11-16T06:19:24.637427+00:00","status":"completed"},"tags":[]},"source":["Self-Play & Search Loop"]},{"cell_type":"code","execution_count":15,"id":"454bf756","metadata":{"execution":{"iopub.execute_input":"2026-11-16T06:19:24.662027Z","iopub.status.busy":"2026-11-16T06:19:24.661521Z","iopub.status.idle":"2026-11-16T06:19:24.665915Z","shell.execute_reply":"2026-11-16T06:19:24.665314Z"},"papermill":{"duration":0.014203,"end_time":"2026-11-16T06:19:24.667295+00:00","exception":false,"start_time":"2026-11-16T06:19:24.653092+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class Node:\n","    max_option: [int]\n","    state: SearchState\n","    max_end: float\n","    obs: Observation\n","    def __init__(self, state: SearchState):\n","        self.max_end = -1.0\n","        self.state = state\n","        self.max_option = None\n","\n","    def option_value(self, option:[int], max_end:float,):\n","        if max_end > self.max_end:\n","            self.max_option = option\n","            self.max_end = max_end"]},{"cell_type":"markdown","id":"b926ab97","metadata":{"papermill":{"duration":0.007598,"end_time":"2026-11-16T06:19:24.683312+00:00","exception":false,"start_time":"2026-11-16T06:19:24.675714+00:00","status":"completed"},"tags":[]},"source":["# Optimal path DFS"]},{"cell_type":"code","execution_count":16,"id":"afc72044","metadata":{"execution":{"iopub.execute_input":"2026-11-16T06:19:24.700113Z","iopub.status.busy":"2026-11-16T06:19:24.699825Z","iopub.status.idle":"2026-11-16T06:19:24.710777Z","shell.execute_reply":"2026-11-16T06:19:24.710133Z"},"papermill":{"duration":0.02113,"end_time":"2026-11-16T06:19:24.712192+00:00","exception":false,"start_time":"2026-11-16T06:19:24.691062+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from itertools import combinations\n","\n","# Search limits are important here. The previous version performed a full\n","# recursive traversal of every combination, which can become enormous.\n","SEARCH_MAX_DEPTH = 8\n","SEARCH_MAX_NODES = 250\n","MAX_BRANCHES = 48\n","\n","\n","def evaluate_state_value(network, obs):\n","    \"\"\"Evaluate a state without creating autograd graphs.\"\"\"\n","    with torch.inference_mode():\n","        return network(encode_state(obs).to(device)).item()\n","\n","\n","def _selection_key(selection):\n","    return tuple(sorted(selection))\n","\n","\n","def _search_key(cur, depth):\n","    # searchId identifies the current search state. Include the selected\n","    # options and depth so repeated search states cannot recurse forever.\n","    return (getattr(cur.state, \"searchId\", None), depth)\n","\n","\n","def optimal_path(cur, network, depth=0, budget=None, seen=None):\n","    if budget is None:\n","        budget = [SEARCH_MAX_NODES]\n","    if seen is None:\n","        seen = set()\n","\n","    # Hard stop: never let one game turn consume unbounded search time.\n","    if depth >= SEARCH_MAX_DEPTH or budget[0] <= 0:\n","        value = evaluate_state_value(network, cur.state.observation)\n","        cur.max_end = value\n","        cur.max_option = None\n","        return cur\n","\n","    key = _search_key(cur, depth)\n","    if key in seen:\n","        value = evaluate_state_value(network, cur.state.observation)\n","        cur.max_end = value\n","        cur.max_option = None\n","        return cur\n","    seen.add(key)\n","    budget[0] -= 1\n","\n","    select = cur.state.observation.select\n","    n = len(select.option)\n","\n","    if n == 0:\n","        cur.max_end = evaluate_state_value(network, cur.state.observation)\n","        return cur\n","\n","    # Do not search every possible cardinality. In particular, an empty\n","    # selection can return the same search state and cause infinite recursion.\n","    # Prefer the normal maxCount action; fall back to minCount only if needed.\n","    counts = [select.maxCount]\n","    if select.minCount != select.maxCount:\n","        counts.append(select.minCount)\n","\n","    selections = []\n","    for count in counts:\n","        if count < 0 or count > n:\n","            continue\n","        if count == 0:\n","            # Avoid the common no-op -> same-state recursion.\n","            continue\n","        selections.extend(combinations(range(n), count))\n","\n","    if not selections:\n","        cur.max_end = evaluate_state_value(network, cur.state.observation)\n","        return cur\n","\n","    # Bound branching. Keep terminal (type 14) selections first because they\n","    # correspond to actual game actions and are what dfs_agent ultimately needs.\n","    terminal = [s for s in selections if all(select.option[i].type == 14 for i in s)]\n","    non_terminal = [s for s in selections if s not in terminal]\n","    selections = terminal + non_terminal\n","    if len(selections) > MAX_BRANCHES:\n","        selections = selections[:MAX_BRANCHES]\n","\n","    # This is a value function, so we are choosing the highest-valued branch.\n","    for selection in selections:\n","        if budget[0] <= 0:\n","            break\n","\n","        selection = list(selection)\n","\n","        # A complete game action: record it as the candidate action.\n","        if all(select.option[i].type == 14 for i in selection):\n","            value = evaluate_state_value(network, cur.state.observation)\n","        else:\n","            try:\n","                child_state = search_step(\n","                    cur.state.searchId,\n","                    selection\n","                )\n","                child = Node(child_state)\n","                child = optimal_path(\n","                    child, network, depth + 1, budget=budget, seen=seen\n","                )\n","                value = child.max_end\n","            except Exception:\n","                # A malformed search branch should not kill the entire move.\n","                continue\n","\n","        cur.option_value(selection, value)\n","\n","    # If every branch failed, evaluate the current state rather than returning\n","    # the default -1 forever.\n","    if cur.max_option is None:\n","        cur.max_end = evaluate_state_value(network, cur.state.observation)\n","\n","    return cur\n"]},{"cell_type":"markdown","id":"91167f22","metadata":{"papermill":{"duration":0.00788,"end_time":"2026-11-16T06:19:24.72789+00:00","exception":false,"start_time":"2026-11-16T06:19:24.72001+00:00","status":"completed"},"tags":[]},"source":["# Agent"]},{"cell_type":"markdown","id":"7ae4f5d6","metadata":{"papermill":{"duration":0.008018,"end_time":"2026-11-16T06:19:24.743676+00:00","exception":false,"start_time":"2026-11-16T06:19:24.735658+00:00","status":"completed"},"tags":[]},"source":["Random agent"]},{"cell_type":"code","execution_count":17,"id":"5254d737","metadata":{"execution":{"iopub.execute_input":"2026-11-16T06:19:24.761132Z","iopub.status.busy":"2026-11-16T06:19:24.760498Z","iopub.status.idle":"2026-11-16T06:19:24.764107Z","shell.execute_reply":"2026-11-16T06:19:24.763511Z"},"papermill":{"duration":0.014091,"end_time":"2026-11-16T06:19:24.765569+00:00","exception":false,"start_time":"2026-11-16T06:19:24.751478+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def random_agent(obs_dict: dict) -> list[int]:\n","    return random.sample(list(range(len(obs_dict[\"select\"][\"option\"]))), obs_dict[\"select\"][\"maxCount\"])"]},{"cell_type":"markdown","id":"e46889de","metadata":{"papermill":{"duration":0.007588,"end_time":"2026-11-16T06:19:24.780994+00:00","exception":false,"start_time":"2026-11-16T06:19:24.773406+00:00","status":"completed"},"tags":[]},"source":["DFS_agent"]},{"cell_type":"code","execution_count":18,"id":"ea1f4292","metadata":{"execution":{"iopub.execute_input":"2026-11-16T06:19:24.798003Z","iopub.status.busy":"2026-11-16T06:19:24.797488Z","iopub.status.idle":"2026-11-16T06:19:24.810036Z","shell.execute_reply":"2026-11-16T06:19:24.809436Z"},"papermill":{"duration":0.022692,"end_time":"2026-11-16T06:19:24.811434+00:00","exception":false,"start_time":"2026-11-16T06:19:24.788742+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["TrainingState updated: bounded batches, shared optimizer, epsilon tracking, and performance tallies.\n"]}],"source":["import re\n","class TrainingState:\n","    \"\"\"Deck-specific exploration/performance state using one shared value network.\"\"\"\n","    network: StateValueNetwork\n","    epsilon: float\n","    epsilon_min: float\n","    epsilon_decay: float\n","    deck: list[int]\n","    deck_name: str\n","\n","    def __init__(\n","        self,\n","        network: StateValueNetwork,\n","        deck: list[int],\n","        optimizer,\n","        deck_name=\"unnamed_deck\",\n","        epsilon=1.0,\n","        epsilon_min=0.1,\n","        epsilon_decay=0.995,\n","    ):\n","        self.network = network\n","        self.deck = deck\n","        self.deck_name = deck_name\n","        self.epsilon = epsilon\n","        self.epsilon_min = epsilon_min\n","        self.epsilon_decay = epsilon_decay\n","        self.optimizer = optimizer\n","        self.loss_fn = nn.MSELoss()\n","\n","        # Low-epsilon performance tally. These only count games played after\n","        # this deck reaches the evaluation threshold.\n","        self.performance = {\n","            \"games\": 0,\n","            \"wins\": 0,\n","            \"losses\": 0,\n","            \"draws\": 0,\n","        }\n","        self.evaluation_started = False\n","\n","    def update_epsilon(self):\n","        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)\n","\n","    def train(self, states, targets, max_batch_size=256):\n","        \"\"\"Train on a bounded batch so CPU RAM cannot grow with generation size.\"\"\"\n","        if not states:\n","            return None\n","        if len(states) != len(targets):\n","            raise ValueError(f\"States: {len(states)}, Targets: {len(targets)}\")\n","\n","        # Hard cap: torch.stack can otherwise create a very large temporary\n","        # tensor on top of the original list of individual tensors.\n","        if len(states) > max_batch_size:\n","            indices = random.sample(range(len(states)), max_batch_size)\n","            states = [states[i] for i in indices]\n","            targets = [targets[i] for i in indices]\n","\n","        batch_states = torch.stack(states).to(device)\n","        batch_targets = torch.as_tensor(\n","            targets, dtype=torch.float32, device=device\n","        ).reshape(-1, 1)\n","\n","        self.network.train()\n","        self.optimizer.zero_grad(set_to_none=True)\n","        predictions = self.network(batch_states)\n","        loss = self.loss_fn(predictions, batch_targets)\n","        loss.backward()\n","        self.optimizer.step()\n","\n","        loss_value = float(loss.detach().cpu())\n","\n","        # Explicitly release large temporaries before returning to the game loop.\n","        del batch_states, batch_targets, predictions, loss\n","        return loss_value\n","\n","    def record_result(self, player_index, winner_index, threshold=0.10):\n","        \"\"\"Count only post-exploration games once this deck is sufficiently trained.\"\"\"\n","        if not self.evaluation_started and self.epsilon <= threshold:\n","            self.evaluation_started = True\n","            print(f\"Evaluation started for deck {self.deck_name} (epsilon={self.epsilon:.3f})\")\n","\n","        if not self.evaluation_started:\n","            return\n","\n","        self.performance[\"games\"] += 1\n","        if winner_index < 0:\n","            self.performance[\"draws\"] += 1\n","        elif winner_index == player_index:\n","            self.performance[\"wins\"] += 1\n","        else:\n","            self.performance[\"losses\"] += 1\n","\n","    def win_rate(self):\n","        games = self.performance[\"games\"]\n","        return self.performance[\"wins\"] / games if games else 0.0\n","\n","    def save_deck_metadata(self, directory=\"trainingState\"):\n","        os.makedirs(directory, exist_ok=True)\n","        safe_name = re.sub(r\"[^A-Za-z0-9_.-]+\", \"_\", self.deck_name)\n","        deck_path = os.path.join(directory, f\"deck_{safe_name}.csv\")\n","        stats_path = os.path.join(directory, f\"performance_{safe_name}.csv\")\n","        with open(deck_path, \"w\", newline=\"\") as f:\n","            csv.writer(f).writerow(self.deck)\n","        with open(stats_path, \"w\", newline=\"\") as f:\n","            writer = csv.writer(f)\n","            writer.writerow([\"games\", \"wins\", \"losses\", \"draws\", \"win_rate\", \"epsilon\"])\n","            writer.writerow([\n","                self.performance[\"games\"],\n","                self.performance[\"wins\"],\n","                self.performance[\"losses\"],\n","                self.performance[\"draws\"],\n","                self.win_rate(),\n","                self.epsilon,\n","            ])\n","\n","\n","def deck_label(deck):\n","    \"\"\"Stable short deck label for console output/files.\"\"\"\n","    return \"_\".join(map(str, deck[:6]))\n","\n","\n","print(\"TrainingState updated: bounded batches, shared optimizer, epsilon tracking, and performance tallies.\")\n"]},{"cell_type":"code","execution_count":19,"id":"98c44d5e","metadata":{"execution":{"iopub.execute_input":"2026-11-16T06:19:24.828087Z","iopub.status.busy":"2026-11-16T06:19:24.827694Z","iopub.status.idle":"2026-11-16T06:19:24.833197Z","shell.execute_reply":"2026-11-16T06:19:24.832639Z"},"papermill":{"duration":0.015244,"end_time":"2026-11-16T06:19:24.834433+00:00","exception":false,"start_time":"2026-11-16T06:19:24.819189+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def dfs_agent(obs_dict: dict, tState: TrainingState):\n","    your_deck = tState.deck\n","    network = tState.network\n","    epsilon = tState.epsilon\n","\n","    if random.random() < epsilon:\n","        return random_agent(obs_dict)\n","\n","    obs = to_observation_class(obs_dict)\n","\n","    your_index = obs.current.yourIndex\n","    state = obs.current\n","    active = state.players[1 - your_index].active\n","\n","    search_state = search_begin(\n","        obs,\n","        your_deck=random.sample(\n","            your_deck,\n","            state.players[your_index].deckCount\n","        ),\n","        your_prize=random.sample(\n","            your_deck,\n","            len(state.players[your_index].prize)\n","        ),\n","        opponent_deck=[1072] * state.players[1 - your_index].deckCount,\n","        opponent_prize=[1] * len(state.players[1 - your_index].prize),\n","        opponent_hand=[1] * state.players[1 - your_index].handCount,\n","        opponent_active=[\n","            1072\n","        ] if len(active) > 0 and active[0] is None else []\n","    )\n","    \n","    node = Node(search_state)\n","\n","    result = optimal_path(node, network)\n","    if result.max_option == None:\n","        return random_agent(obs_dict)\n","\n","    return result.max_option"]},{"cell_type":"markdown","id":"2c5fc6b7","metadata":{"id":"3181dbbd","papermill":{"duration":0.008128,"end_time":"2026-11-16T06:19:24.850463+00:00","exception":false,"start_time":"2026-11-16T06:19:24.842335+00:00","status":"completed"},"tags":[]},"source":["## Define Reward Function\n","\n","### Subtask:\n","Implement a `reward_function` that takes the game observation and returns a reward based on the number of Pokémon each player defeated. For now, the reward will be a normalized difference in defeated Pokémon."]},{"cell_type":"markdown","id":"f1165c1e","metadata":{"id":"f13f4d69","papermill":{"duration":0.007866,"end_time":"2026-11-16T06:19:24.867578+00:00","exception":false,"start_time":"2026-11-16T06:19:24.859712+00:00","status":"completed"},"tags":[]},"source":["**Reasoning**:\n","This code block defines the `reward_function`. It calculates the reward based on the game's final observation, specifically the difference in Pokémon defeated by each player, and normalizes it by 6 (assuming a maximum of 6 Pokémon per player). This will serve as a basic signal for the agent to learn from."]},{"cell_type":"code","execution_count":20,"id":"4d05c5d4","metadata":{"execution":{"iopub.execute_input":"2026-11-16T06:19:24.884667Z","iopub.status.busy":"2026-11-16T06:19:24.8842Z","iopub.status.idle":"2026-11-16T06:19:24.889561Z","shell.execute_reply":"2026-11-16T06:19:24.888852Z"},"executionInfo":{"elapsed":3160,"status":"ok","timestamp":1784343992107,"user":{"displayName":"Tyson Schneider","userId":"06213622759790006542"},"user_tz":-600},"id":"18541ec4","outputId":"0e7ae8e7-3784-4a9e-8258-4b2da9a3caf0","papermill":{"duration":0.015392,"end_time":"2026-11-16T06:19:24.891009+00:00","exception":false,"start_time":"2026-11-16T06:19:24.875617+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Reward function uses plain floats to keep episode memory small.\n"]}],"source":["def reward_function(final_obs_dict, current_player_index):\n","    \"\"\"Return a plain Python float so rewards do not retain device tensors.\"\"\"\n","    obs = to_observation_class(final_obs_dict)\n","    opponent_player_index = 1 if current_player_index == 0 else 0\n","\n","    if len(obs.current.players[current_player_index].prize) < 6 and len(obs.current.players[opponent_player_index].prize) < 6:\n","        return 1.0 if obs.current.result == current_player_index else -1.0\n","\n","    player_prizes = len(obs.current.players[current_player_index].prize)\n","    opponent_prizes = len(obs.current.players[opponent_player_index].prize)\n","    return float((player_prizes - opponent_prizes) / 6.0)\n","\n","print(\"Reward function uses plain floats to keep episode memory small.\")\n"]},{"cell_type":"markdown","id":"78240e90","metadata":{"id":"891b0385","papermill":{"duration":0.007949,"end_time":"2026-11-16T06:19:24.907493+00:00","exception":false