s.select.option[choice[0]].type == 14:\n","                # Only retain a bounded number of training states.\n","                if current_player_index == 0:\n","                    player0_experiences.append(encode_state(obs))\n","                else:\n","                    player1_experiences.append(encode_state(obs))\n","\n","            next_obs = battle_select(choice)\n","            if next_obs is None:\n","                raise RuntimeError(\"battle_select returned None\")\n","            obs_dict_current = next_obs\n","\n","            if obs_dict_current[\"current\"][\"result\"] >= 0:\n","                break\n","        else:\n","            print(f\"WARNING: episode hit max_turns={max_turns}; treating as a draw\")\n","\n","        final_reward_p0 = reward_function(obs_dict_current, 0)\n","        final_reward_p1 = reward_function(obs_dict_current, 1)\n","        winner_index = int(obs_dict_current[\"current\"].get(\"result\", -1))\n","\n","        # Only start tallying once the individual deck has reached low epsilon.\n","        tState0.record_result(0, winner_index, PERFORMANCE_EPSILON_THRESHOLD)\n","        if tState1 is not tState0:\n","            tState1.record_result(1, winner_index, PERFORMANCE_EPSILON_THRESHOLD)\n","\n","        return list(player0_experiences), final_reward_p0, list(player1_experiences), final_reward_p1\n","    finally:\n","        tState0.update_epsilon()\n","        tState1.update_epsilon()\n","        battle_finish()\n","        # The next episode should not inherit any dead Python objects.\n","        del player0_experiences, player1_experiences\n","\n","print(\"play_one_episode updated with a hard per-player RAM ceiling and low-epsilon tallying.\")\n"]},{"cell_type":"markdown","id":"03edc323","metadata":{"id":"81f0640e","papermill":{"duration":0.008021,"end_time":"2026-11-16T06:19:24.951398+00:00","exception":false,"start_time":"2026-11-16T06:19:24.943377+00:00","status":"completed"},"tags":[]},"source":["Run generatio